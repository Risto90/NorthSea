Name: north-sea
Version: @VERSION@
Release: 1%{?dist}
Summary: Морское приключение в раннем Средневековье
License: NOASSERTION
URL: https://risto90.github.io/NorthSea/
BuildArch: x86_64
Requires: glibc
Requires: libgcc
Requires: libX11
Requires: vulkan-loader
Requires: mesa-libEGL
Requires: mesa-libGL
Requires: mesa-libgbm
Source0: %{name}-%{version}.tar.gz

%description
North Sea — нативное приложение с графикой устройства.

%prep
%setup -q -n %{name}-%{version}

%build

%install
mkdir -p %{buildroot}
cp -a . %{buildroot}/

%files
%attr(0755,root,root) /usr/bin/north-sea
%attr(0755,root,root) /usr/libexec/north-sea/north-sea
/usr/share/applications/north-sea.desktop
/usr/share/icons/hicolor/128x128/apps/north-sea.png
