Name: north-seas-adventure
Version: @VERSION@
Release: 1%{?dist}
Summary: Морское приключение в раннем Средневековье
License: NOASSERTION
URL: https://github.com/Risto90/NorthSea
BuildArch: x86_64
Requires: bash
Requires: xdg-utils
Source0: %{name}-%{version}.tar.gz

%description
Моря Туманного Севера — приключенческая игра, запускаемая в системном браузере.

%prep
%setup -q -n %{name}-%{version}

%build

%install
mkdir -p %{buildroot}
cp -a . %{buildroot}/

%files
%attr(0755,root,root) /usr/bin/north-seas-adventure
%attr(0755,root,root) /usr/libexec/north-seas-adventure/web-preview
/usr/share/applications/north-seas-adventure.desktop
/usr/share/icons/hicolor/scalable/apps/north-seas-adventure.svg
/usr/share/north-seas-adventure/www/
